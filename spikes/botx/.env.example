# Спайк BotX: скопировать в .env рядом и заполнить из .env ботов.
# Формат docker --env-file: KEY=value, без кавычек, без export, без пробелов у «=».

# CTS_URL из .env ботов. Спека §3 закладывает один на оба бота — если у ботов
# он разный, сообщи: это правка спеки
PA_BOOKING_BOTX_CTS_URL=

# psy_bot_v2: BOT_ID, BOT_SECRET_KEY, NOTIFY_CHAT_ID
PA_BOOKING_APPOINTMENTS_BOT_ID=
PA_BOOKING_APPOINTMENTS_BOT_SECRET=
PA_BOOKING_APPOINTMENTS_NOTIFY_CHAT_ID=

# Library_bot: BOT_ID, BOT_SECRET_KEY, NOTIFICATION_CHAT_ID
PA_BOOKING_LIBRARY_BOT_ID=
PA_BOOKING_LIBRARY_BOT_SECRET=
PA_BOOKING_LIBRARY_NOTIFY_CHAT_ID=
